{
  "name": "clean-start",
  "version": "1.0.9",
  "type": "commonjs",
  "description": "History, cache, cookie, and storage cleaner Chrome extension scaffolded in the style of CleanReload.",
  "scripts": {
    "sync:support": "node --preserve-symlinks-main ./node_modules/kagayoi-support-extension/bin/kagayoi-support-sync.mjs",
    "prebuild": "pnpm sync:support",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node webstore/generate-screenshots.js",
    "build": "pnpm run generate-icons && pnpm run generate-screenshots",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "4.0.1",
    "kagayoi-support-extension": "1.0.5",
    "puppeteer": "25.9.0",
    "sharp": "0.35.4"
  },
  "keywords": [
    "chrome-extension",
    "history-cleaner",
    "cache-cleaner",
    "cookie-cleaner"
  ],
  "author": "",
  "license": "MIT"
}
