{
  "name": "clean-start",
  "version": "1.0.8",
  "type": "commonjs",
  "description": "History, cache, cookie, and storage cleaner Chrome extension scaffolded in the style of CleanReload.",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node webstore/generate-screenshots.js",
    "build": "pnpm run generate-icons && pnpm run generate-screenshots",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "4.0.1",
    "puppeteer": "25.7.0",
    "sharp": "0.35.3"
  },
  "keywords": [
    "chrome-extension",
    "history-cleaner",
    "cache-cleaner",
    "cookie-cleaner"
  ],
